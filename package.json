{
  "name": "be",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "start:dev": "cross-env NODE_ENV=development node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "build": "esbuild server.js --bundle --platform=node --target=node20 --outfile=dist/server.js --minify --external:pg-hstore --external:sqlite3 --external:mysql2 --external:pg --external:sequelize --external:bcryptjs --external:exceljs --external:canvas",
    "postinstall": "npm run build",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "docxtemplater": "^3.68.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "html-to-docx": "^1.8.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pizzip": "^3.2.0",
    "sequelize": "^6.37.8",
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2"
  }
}
